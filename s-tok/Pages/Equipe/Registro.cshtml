@page
@model s_tok.Pages.Equipe.RegistroModel
@{
    ViewData["Title"] = "Registrar usuário";
}

<div class="page-heading">
    <div>
        <h1>Registrar usuário</h1>
        <p>
            Cadastre um integrante da equipe e configure seu acesso ao S-TOK.
        </p>
    </div>

    <a asp-page="/Equipe/Index" class="btn btn-outline-secondary">
        Voltar para equipe
    </a>
</div>

<section class="content-panel">
    <header class="panel-header">
        <div>
            <h2 class="panel-title">Dados pessoais e acesso</h2>
            <div class="panel-subtitle">
                Preencha os dados para criar uma nova conta.
            </div>
        </div>
    </header>

    <div class="p-4">
        <form method="post">
            <div asp-validation-summary="ModelOnly"
                 class="text-danger mb-3">
            </div>

            <div class="mb-4">
                <h3 class="h6 fw-semibold mb-3">
                    <span class="me-2">01.</span>
                    Identificação pessoal
                </h3>

                <div class="mb-3">
                    <label asp-for="Entrada.NomeCompleto"
                           class="form-label"></label>

                    <input asp-for="Entrada.NomeCompleto"
                           class="form-control"
                           placeholder="Digite o nome completo"
                           autocomplete="name" />

                    <span asp-validation-for="Entrada.NomeCompleto"
                          class="text-danger small"></span>
                </div>
            </div>

            <hr class="my-4" />

            <div class="mb-4">
                <h3 class="h6 fw-semibold mb-3">
                    <span class="me-2">02.</span>
                    Credenciais de acesso
                </h3>

                <div class="row g-3">
                    <div class="col-12 col-md-6">
                        <label asp-for="Entrada.Email"
                               class="form-label"></label>

                        <input asp-for="Entrada.Email"
                               class="form-control"
                               placeholder="nome@empresa.com"
                               autocomplete="email" />

                        <span asp-validation-for="Entrada.Email"
                              class="text-danger small"></span>
                    </div>

                    <div class="col-12 col-md-6">
                        <label asp-for="Entrada.Username"
                               class="form-label"></label>

                        <input asp-for="Entrada.Username"
                               class="form-control"
                               placeholder="Escolha um nome de usuário"
                               autocomplete="username" />

                        <span asp-validation-for="Entrada.Username"
                              class="text-danger small"></span>
                    </div>

                    <div class="col-12 col-md-6">
                        <label asp-for="Entrada.Senha"
                               class="form-label"></label>

                        <input asp-for="Entrada.Senha"
                               class="form-control"
                               autocomplete="new-password" />

                        <span asp-validation-for="Entrada.Senha"
                              class="text-danger small"></span>

                        <div class="form-text">
                            Utilize pelo menos 12 caracteres, incluindo
                            letras maiúsculas, minúsculas, números e símbolos.
                        </div>
                    </div>

                    <div class="col-12 col-md-6">
                        <label asp-for="Entrada.ConfirmarSenha"
                               class="form-label"></label>

                        <input asp-for="Entrada.ConfirmarSenha"
                               class="form-control"
                               autocomplete="new-password" />

                        <span asp-validation-for="Entrada.ConfirmarSenha"
                              class="text-danger small"></span>
                    </div>
                </div>
            </div>

            <hr class="my-4" />

            <div class="mb-4">
                <h3 class="h6 fw-semibold mb-3">
                    <span class="me-2">03.</span>
                    Perfil de acesso
                </h3>

                <div class="mb-3">
                    <label asp-for="Entrada.Perfil"
                           class="form-label"></label>

                    <select asp-for="Entrada.Perfil"
                            class="form-select">
                        <option value="">Selecione um perfil</option>
                        @foreach (var perfil in Model.PerfisDisponiveis)
                        {
                            <option value="@perfil">@perfil</option>
                        }
                    </select>

                    <span asp-validation-for="Entrada.Perfil"
                          class="text-danger small"></span>

                    <div class="form-text">
                        Os perfis disponíveis dependem das suas permissões.
                    </div>
                </div>
            </div>

            <div class="d-flex flex-wrap justify-content-end gap-2 mt-4">
                <a asp-page="/Equipe/Index"
                   class="btn btn-outline-secondary">
                    Cancelar
                </a>

                <button type="submit" class="btn btn-primary">
                    Registrar usuário
                </button>
            </div>
        </form>
    </div>
</section>

@section Scripts {
    <partial name="_ValidationScriptsPartial" />
}
