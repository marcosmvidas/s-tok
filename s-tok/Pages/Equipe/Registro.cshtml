@page
@model s_tok.Pages.Equipe.RegistroModel

@{
    Layout = "_CadastroLayout";
    ViewData["PaginaVoltar"] = "/Equipe/Index";
    ViewData["TextoVoltar"] = "Voltar";

    if (Model.DadosComplementares is not null)
    {
        ViewData["ModoComplementar"] = true;
        ViewData["Title"] = "Dados complementares da equipe";
        ViewData["Descricao"] = "O acesso e o cadastro da pessoa foram criados. Inclua os dados complementares.";
        ViewData["PainelTitulo"] = "Complementação do cadastro";
        ViewData["PainelSubtitulo"] = Model.DadosComplementares.NomePessoa;
    }
    else
    {
        ViewData["Title"] = "Cadastro de membro da equipe";
        ViewData["Descricao"] = "Preencha os dados pessoais e as credenciais de acesso.";
        ViewData["PainelTitulo"] = "Novo cadastro";
        ViewData["PainelSubtitulo"] = "Dados pessoais e credenciais";
        ViewData["TextoSalvar"] = "Criar cadastro";
    }
}

@if (Model.DadosComplementares is not null)
{
    <partial name="_DadosComplementaresPessoa" model="Model.DadosComplementares" />
}
else
{
    <div class="mb-4">
        <h3 class="h6 fw-semibold mb-3"><span class="me-2">01.</span>Identificação pessoal</h3>
        <div class="mb-3">
            <label asp-for="Entrada.NomeCompleto" class="form-label"></label>
            <input asp-for="Entrada.NomeCompleto" class="form-control"
                   placeholder="Digite o nome completo" autocomplete="name" />
            <span asp-validation-for="Entrada.NomeCompleto" class="text-danger small"></span>
        </div>
    </div>

    <hr class="my-4" />

    <div class="mb-4">
        <h3 class="h6 fw-semibold mb-3"><span class="me-2">02.</span>Credenciais de acesso</h3>
        <div class="row g-3">
            <div class="col-12 col-md-6">
                <label asp-for="Entrada.Email" class="form-label"></label>
                <input asp-for="Entrada.Email" class="form-control"
                       placeholder="nome@empresa.com" autocomplete="email" />
                <span asp-validation-for="Entrada.Email" class="text-danger small"></span>
            </div>
            <div class="col-12 col-md-6">
                <label asp-for="Entrada.Username" class="form-label"></label>
                <input asp-for="Entrada.Username" class="form-control"
                       placeholder="Escolha um nome de usuário" autocomplete="username" />
                <span asp-validation-for="Entrada.Username" class="text-danger small"></span>
            </div>
            <div class="col-12 col-md-6">
                <label asp-for="Entrada.Senha" class="form-label"></label>
                <input asp-for="Entrada.Senha" class="form-control" autocomplete="new-password" />
                <span asp-validation-for="Entrada.Senha" class="text-danger small"></span>
                <div class="form-text">Utilize pelo menos 12 caracteres, incluindo letras maiúsculas, minúsculas, números e símbolos.</div>
            </div>
            <div class="col-12 col-md-6">
                <label asp-for="Entrada.ConfirmarSenha" class="form-label"></label>
                <input asp-for="Entrada.ConfirmarSenha" class="form-control" autocomplete="new-password" />
                <span asp-validation-for="Entrada.ConfirmarSenha" class="text-danger small"></span>
            </div>
        </div>
    </div>

    <hr class="my-4" />

    <div class="mb-4">
        <h3 class="h6 fw-semibold mb-3"><span class="me-2">03.</span>Perfil de acesso</h3>
        <div class="mb-3">
            <label asp-for="Entrada.Perfil" class="form-label"></label>
            <select asp-for="Entrada.Perfil" class="form-select">
                <option value="">Selecione um perfil</option>
                @foreach (var perfil in Model.PerfisDisponiveis)
                {
                    <option value="@perfil">@perfil</option>
                }
            </select>
            <span asp-validation-for="Entrada.Perfil" class="text-danger small"></span>
            <div class="form-text">Os perfis disponíveis dependem das suas permissões.</div>
        </div>
    </div>
}
