
<!DOCTYPE html>
<html lang="pt-BR">
<head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />

    <title>@ViewData["Title"] - S-TOK</title>

    <link rel="stylesheet"
          href="~/lib/bootstrap/dist/css/bootstrap.min.css" />

    <link rel="stylesheet"
          href="~/css/site.css"
          asp-append-version="true" />

    @await RenderSectionAsync("Styles", required: false)
</head>

<body>
    <div class="app-shell">

        <aside class="sidebar" id="sidebar">

            <!-- MARCA -->
            <a class="brand" asp-page="/Index">
                <span class="brand-mark">S</span>
                <span class="brand-name">S-TOK</span>
            </a>

            <!-- NAVEGAÇÃO -->
            <nav class="sidebar-nav" id="sidebarNav"
                 aria-label="Menu principal">

                <div class="sidebar-caption">MENU PRINCIPAL</div>

                <!-- DASHBOARD -->
                <a class="nav-item nav-link-page"
                   asp-page="/Index">
                    <span class="nav-icon">▦</span>
                    <span>Dashboard</span>
                </a>

                <div class="sidebar-caption sidebar-caption-spaced">
                    MÓDULOS
                </div>

                <div id="sidebarNavGroups">

                    <!-- FINANCEIRO -->
                    <button class="nav-item nav-item-toggle collapsed"
                            type="button"
                            data-bs-toggle="collapse"
                            data-bs-target="#menuFinanceiro"
                            aria-expanded="false"
                            aria-controls="menuFinanceiro">
                        <span class="nav-icon">＄</span>
                        <span>Financeiro</span>
                        <span class="submenu-arrow">⌄</span>
                    </button>

                    <div class="collapse submenu"
                         id="menuFinanceiro"
                         data-bs-parent="#sidebarNavGroups">

                        <a class="submenu-item nav-link-page"
                           asp-page="/Financeiro/Lancamento/Index">
                            Lançamentos
                        </a>

                        <a class="submenu-item nav-link-page"
                           asp-page="/Financeiro/ContasPagar/Index">
                            Contas a pagar
                        </a>

                        <a class="submenu-item nav-link-page"
                           asp-page="/Financeiro/ContasReceber/Index">
                            Contas a receber
                        </a>

                        <a class="submenu-item nav-link-page"
                           asp-page="/Financeiro/FluxoCaixa/Index">
                            Fluxo de caixa
                        </a>

                        <a class="submenu-item nav-link-page"
                           asp-page="/Financeiro/Relatorios/Index">
                            Relatórios financeiros
                        </a>
                    </div>

                    <!-- COMERCIAL -->
                    <button class="nav-item nav-item-toggle collapsed"
                            type="button"
                            data-bs-toggle="collapse"
                            data-bs-target="#menuComercial"
                            aria-expanded="false"
                            aria-controls="menuComercial">
                        <span class="nav-icon">▣</span>
                        <span>Comercial</span>
                        <span class="submenu-arrow">⌄</span>
                    </button>

                    <div class="collapse submenu"
                         id="menuComercial"
                         data-bs-parent="#sidebarNavGroups">

                        <span class="submenu-item is-disabled">
                            Orçamentos <small>Em breve</small>
                        </span>
                        <span class="submenu-item is-disabled">
                            Pedidos <small>Em breve</small>
                        </span>
                        <span class="submenu-item is-disabled">
                            Vendas <small>Em breve</small>
                        </span>
                        <span class="submenu-item is-disabled">
                            Devoluções <small>Em breve</small>
                        </span>
                        <span class="submenu-item is-disabled">
                            Comissões <small>Em breve</small>
                        </span>
                    </div>

                    <!-- COMPRAS -->
                    <button class="nav-item nav-item-toggle collapsed"
                            type="button"
                            data-bs-toggle="collapse"
                            data-bs-target="#menuCompras"
                            aria-expanded="false"
                            aria-controls="menuCompras">
                        <span class="nav-icon">🛒</span>
                        <span>Compras e suprimentos</span>
                        <span class="submenu-arrow">⌄</span>
                    </button>

                    <div class="collapse submenu"
                         id="menuCompras"
                         data-bs-parent="#sidebarNavGroups">

                        <span class="submenu-item is-disabled">
                            Solicitações de compra <small>Em breve</small>
                        </span>
                        <span class="submenu-item is-disabled">
                            Cotações <small>Em breve</small>
                        </span>
                        <span class="submenu-item is-disabled">
                            Pedidos de compra <small>Em breve</small>
                        </span>
                        <span class="submenu-item is-disabled">
                            Recebimentos <small>Em breve</small>
                        </span>
                    </div>

                    <!-- ESTOQUE -->
                    <button class="nav-item nav-item-toggle collapsed"
                            type="button"
                            data-bs-toggle="collapse"
                            data-bs-target="#menuEstoque"
                            aria-expanded="false"
                            aria-controls="menuEstoque">
                        <span class="nav-icon">▤</span>
                        <span>Estoque</span>
                        <span class="submenu-arrow">⌄</span>
                    </button>

                    <div class="collapse submenu"
                         id="menuEstoque"
                         data-bs-parent="#sidebarNavGroups">

                        <a class="submenu-item nav-link-page"
                           asp-page="/Produtos/Index">
                            Produtos
                        </a>

                        <span class="submenu-item is-disabled">
                            Entradas e saídas <small>Em breve</small>
                        </span>
                        <span class="submenu-item is-disabled">
                            Transferências <small>Em breve</small>
                        </span>
                        <span class="submenu-item is-disabled">
                            Inventário <small>Em breve</small>
                        </span>
                        <span class="submenu-item is-disabled">
                            Categorias <small>Em breve</small>
                        </span>
                    </div>

                    <!-- CADASTROS -->
                    <div class="sidebar-caption sidebar-caption-spaced">
                        GESTÃO
                    </div>

                    <button class="nav-item nav-item-toggle collapsed"
                            type="button"
                            data-bs-toggle="collapse"
                            data-bs-target="#menuCadastros"
                            aria-expanded="false"
                            aria-controls="menuCadastros">
                        <span class="nav-icon">♙</span>
                        <span>Cadastros</span>
                        <span class="submenu-arrow">⌄</span>
                    </button>

                    <div class="collapse submenu"
                         id="menuCadastros"
                         data-bs-parent="#sidebarNavGroups">

                        <a class="submenu-item nav-link-page"
                           asp-page="/Cliente/Index">
                            Clientes
                        </a>

                        <a class="submenu-item nav-link-page"
                           asp-page="/Fornecedor/Index">
                            Fornecedores
                        </a>

                        <a class="submenu-item nav-link-page"
                           asp-page="/Equipe/Index">
                            Equipe
                        </a>

                        <a class="submenu-item nav-link-page"
                           asp-page="/Contato/Index">
                            Contatos
                        </a>

                        <a class="submenu-item nav-link-page"
                           asp-page="/Endereco/Index">
                            Endereços
                        </a>

                        <a class="submenu-item nav-link-page"
                           asp-page="/Documento/Index">
                            Documentos
                        </a>
                    </div>

                    <!-- PESSOAL / RH -->
                    <button class="nav-item nav-item-toggle collapsed"
                            type="button"
                            data-bs-toggle="collapse"
                            data-bs-target="#menuRh"
                            aria-expanded="false"
                            aria-controls="menuRh">
                        <span class="nav-icon">♧</span>
                        <span>Pessoal / RH</span>
                        <span class="submenu-arrow">⌄</span>
                    </button>

                    <div class="collapse submenu"
                         id="menuRh"
                         data-bs-parent="#sidebarNavGroups">

                        <span class="submenu-item is-disabled">
                            Folha de pagamento <small>Em breve</small>
                        </span>
                        <span class="submenu-item is-disabled">
                            Rubricas <small>Em breve</small>
                        </span>
                        <span class="submenu-item is-disabled">
                            Cargos e funções <small>Em breve</small>
                        </span>
                        <span class="submenu-item is-disabled">
                            Férias e afastamentos <small>Em breve</small>
                        </span>
                    </div>

                    <!-- RELATÓRIOS -->
                    <button class="nav-item nav-item-toggle collapsed"
                            type="button"
                            data-bs-toggle="collapse"
                            data-bs-target="#menuRelatorios"
                            aria-expanded="false"
                            aria-controls="menuRelatorios">
                        <span class="nav-icon">▥</span>
                        <span>Relatórios</span>
                        <span class="submenu-arrow">⌄</span>
                    </button>

                    <div class="collapse submenu"
                         id="menuRelatorios"
                         data-bs-parent="#sidebarNavGroups">

                        <span class="submenu-item is-disabled">
                            Relatórios gerenciais <small>Em breve</small>
                        </span>
                        <span class="submenu-item is-disabled">
                            Relatórios operacionais <small>Em breve</small>
                        </span>
                    </div>

                    <!-- CONFIGURAÇÕES -->
                    <button class="nav-item nav-item-toggle collapsed"
                            type="button"
                            data-bs-toggle="collapse"
                            data-bs-target="#menuConfiguracoes"
                            aria-expanded="false"
                            aria-controls="menuConfiguracoes">
                        <span class="nav-icon">⚙</span>
                        <span>Configurações</span>
                        <span class="submenu-arrow">⌄</span>
                    </button>

                    <div class="collapse submenu"
                         id="menuConfiguracoes"
                         data-bs-parent="#sidebarNavGroups">

                        <span class="submenu-item is-disabled">
                            Usuários e permissões <small>Em breve</small>
                        </span>
                        <span class="submenu-item is-disabled">
                            Empresas e filiais <small>Em breve</small>
                        </span>
                        <span class="submenu-item is-disabled">
                            Parâmetros do sistema <small>Em breve</small>
                        </span>
                    </div>

                </div>
            </nav>

            <!-- RODAPÉ DA SIDEBAR -->
            <div class="sidebar-footer">
                <div class="sidebar-footer-mark">S</div>
                <div>
                    <strong>S-TOK</strong>
                    <span>Gestão inteligente</span>
                </div>
            </div>

        </aside>

        <!-- ÁREA PRINCIPAL -->
        <div class="main-area">

            <header class="topbar">

                <button class="menu-toggle"
                        id="menuToggle"
                        type="button"
                        aria-label="Abrir ou fechar menu"
                        aria-controls="sidebar"
                        aria-expanded="false">
                    ☰
                </button>

                <div class="topbar-context">
                    <span class="topbar-label">SISTEMA DE GESTÃO</span>
                    <span class="topbar-title">Painel administrativo</span>
                </div>

                <div class="topbar-actions">

                    <div class="system-status">
                        <span class="status-dot"></span>
                        Ambiente de desenvolvimento
                    </div>

                    <div class="user-avatar"
                         aria-label="Perfil do usuário">
                        U
                    </div>

                    <form method="post" asp-page="/Account/Logout">
                        <button type="submit" class="btn btn-link">
                            Sair
                        </button>
                    </form>

                </div>
            </header>

            <main class="page-content" role="main">
                @RenderBody()
            </main>

            <footer class="app-footer">
                <span>© @DateTime.Now.Year S-TOK</span>
                <span>Gestão de estoque inteligente</span>
            </footer>

        </div>
    </div>

    <div class="sidebar-overlay" id="sidebarOverlay"></div>

    <script src="~/lib/bootstrap/dist/js/bootstrap.bundle.min.js"></script>
    <script src="~/js/site.js" asp-append-version="true"></script>

    @await RenderSectionAsync("Scripts", required: false)

</body>
</html>
