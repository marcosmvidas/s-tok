@model s_tok.Pages.Shared.GridListagemModel

<partial name="_CabecalhoPagina"
         model="@(new s_tok.Pages.Shared.CabecalhoPaginaModel {
             Titulo = Model.Titulo,
             Descricao = Model.Descricao,
             PaginaNovo = Model.PaginaNovo,
             TextoBotaoNovo = Model.TextoBotaoNovo
         })" />

<section class="content-panel panel-listagem">
    <header class="panel-header">
        <div>
            <h2 class="panel-title">@Model.Titulo</h2>

            @if (!string.IsNullOrWhiteSpace(Model.Descricao))
            {
                <div class="panel-subtitle">@Model.Descricao</div>
            }
        </div>
    </header>

    @{
        var itens = Model.Itens.ToList();

        var temAcoes =
            !string.IsNullOrWhiteSpace(Model.PaginaDetalhes)
            || !string.IsNullOrWhiteSpace(Model.PaginaAlterar)
            || !string.IsNullOrWhiteSpace(Model.PaginaExcluir);
    }

    <div class="table-responsive listagem-wrapper">
        <table class="table table-stok table-hover align-middle table-listagem">
            <thead>
                <tr>
                    @foreach (var coluna in Model.Colunas)
                    {
                        <th scope="col">@coluna.Titulo</th>
                    }

                    @if (temAcoes)
                    {
                        <th scope="col" class="col-acoes">
                            AÇÕES
                        </th>
                    }
                </tr>
            </thead>

            <tbody>
                @if (itens.Count == 0)
                {
                    <tr>
                        <td colspan="@(Model.Colunas.Count + (temAcoes ? 1 : 0))"
                            class="listagem-vazia">
                            <div class="empty-state">
                                <span class="empty-state-title">
                                    Nenhum registro encontrado
                                </span>

                                <span class="empty-state-description">
                                    @Model.MensagemVazia
                                </span>
                            </div>
                        </td>
                    </tr>
                }
                else
                {
                    @foreach (var item in itens)
                    {
                        <tr>
                            @foreach (var coluna in Model.Colunas)
                            {
                                <td class="@coluna.ClasseCss">
                                    @if (string.Equals(
                                        coluna.Formato,
                                        "email-confirmado",
                                        StringComparison.OrdinalIgnoreCase))
                                    {
                                        var confirmado = string.Equals(
                                            Model.ObterValorFormatado(item, coluna),
                                            "Sim",
                                            StringComparison.Ordinal);

                                        <span class="stock-badge @(confirmado ? "ok" : "low")">
                                            @(confirmado ? "Confirmado" : "Pendente")
                                        </span>
                                    }
                                    else
                                    {
                                        @Model.ObterValorFormatado(item, coluna)
                                    }
                                </td>
                            }

                            @if (temAcoes)
                            {
                                <td class="col-acoes">
                                    <div class="listagem-acoes">
                                        <partial name="_BotoesAcoes"
                                                 model="@(new s_tok.Pages.Shared.AcoesListagemModel {
                                                     Id = Model.ObterId(item),
                                                     NomeRegistro = Model.ObterNome(item),
                                                     DetalhesPage = Model.PaginaDetalhes ?? string.Empty,
                                                     AlterarPage = Model.PaginaAlterar ?? string.Empty,
                                                     ExcluirPage = Model.PaginaExcluir ?? string.Empty
                                                 })" />
                                    </div>
                                </td>
                            }
                        </tr>
                    }
                }
            </tbody>
        </table>
    </div>
</section>
