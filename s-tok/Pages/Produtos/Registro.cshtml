@page
@model s_tok.Pages.Produtos.RegistroModel

@{
    Layout = "_Registro";
    ViewData["Title"] = "Novo produto";
    ViewData["Descricao"] = "Preencha os dados para adicionar um produto ao catálogo.";
    ViewData["PaginaVoltar"] = "/Produtos/Index";
    ViewData["TextoVoltar"] = "Voltar para produtos";
    ViewData["PainelTitulo"] = "Dados do produto";
    ViewData["PainelSubtitulo"] = "Os campos com validação devem ser preenchidos corretamente.";
    ViewData["TextoSalvar"] = "Cadastrar produto";
}

<div class="row g-3">
    <div class="col-12 col-md-4">
        <label asp-for="Produto.Codigo" class="form-label">Código</label>
        <input asp-for="Produto.Codigo" class="form-control" maxlength="40" />
        <span asp-validation-for="Produto.Codigo" class="text-danger small"></span>
    </div>

    <div class="col-12 col-md-8">
        <label asp-for="Produto.Nome" class="form-label">Nome</label>
        <input asp-for="Produto.Nome" class="form-control" maxlength="120" />
        <span asp-validation-for="Produto.Nome" class="text-danger small"></span>
    </div>

    <div class="col-12 col-md-6">
        <label asp-for="Produto.CategoriaId" class="form-label">Categoria</label>
        <select asp-for="Produto.CategoriaId" asp-items="Model.Categorias" class="form-select">
            <option value="">Selecione</option>
        </select>
        <span asp-validation-for="Produto.CategoriaId" class="text-danger small"></span>
    </div>

    <div class="col-12 col-md-6">
        <label asp-for="Produto.FornecedorId" class="form-label">Fornecedor</label>
        <select asp-for="Produto.FornecedorId" asp-items="Model.Fornecedores" class="form-select">
            <option value="">Selecione</option>
        </select>
        <span asp-validation-for="Produto.FornecedorId" class="text-danger small"></span>
    </div>

    <div class="col-6 col-md-3">
        <label asp-for="Produto.UnidadeBase" class="form-label">Unidade</label>
        <input asp-for="Produto.UnidadeBase" class="form-control" maxlength="10" />
        <span asp-validation-for="Produto.UnidadeBase" class="text-danger small"></span>
    </div>

    <div class="col-6 col-md-3">
        <label asp-for="Produto.PrecoCusto" class="form-label">Preço de custo</label>
        <input asp-for="Produto.PrecoCusto" class="form-control" inputmode="decimal" />
        <span asp-validation-for="Produto.PrecoCusto" class="text-danger small"></span>
    </div>

    <div class="col-6 col-md-3">
        <label asp-for="Produto.PrecoVenda" class="form-label">Preço de venda</label>
        <input asp-for="Produto.PrecoVenda" class="form-control" inputmode="decimal" />
        <span asp-validation-for="Produto.PrecoVenda" class="text-danger small"></span>
    </div>

    <div class="col-6 col-md-3">
        <label asp-for="Produto.EstoqueMinimo" class="form-label">Estoque mínimo</label>
        <input asp-for="Produto.EstoqueMinimo" class="form-control" inputmode="decimal" />
        <span asp-validation-for="Produto.EstoqueMinimo" class="text-danger small"></span>
    </div>

    <div class="col-12">
        <div class="form-check">
            <input asp-for="Produto.Ativo" class="form-check-input" />
            <label asp-for="Produto.Ativo" class="form-check-label">Produto ativo</label>
        </div>
    </div>
</div>
