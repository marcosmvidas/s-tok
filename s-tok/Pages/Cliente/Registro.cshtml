@page
@model s_tok.Pages.Clientes.RegistroModel
@using s_tok.Models.Enums

@{
    Layout = "_CadastroLayout";

    ViewData["Title"] = "Novo cliente";
    ViewData["Descricao"] = "Vincule uma pessoa existente ou cadastre uma nova pessoa como cliente.";
    ViewData["PaginaVoltar"] = "/Cliente/Index";
    ViewData["TextoVoltar"] = "Voltar";
    ViewData["PainelTitulo"] = "Dados do cliente";
    ViewData["PainelSubtitulo"] = "Identificação da pessoa e informações comerciais";
    ViewData["TextoSalvar"] = "Salvar cliente";
}

<div class="mb-4">
    <h3 class="h6 fw-semibold mb-3">01. Pessoa</h3>
    <div class="row g-3">
        <div class="col-12">
            <label asp-for="Input.PessoaId" class="form-label"></label>
            <select asp-for="Input.PessoaId" asp-items="Model.PessoasDisponiveis" class="form-select">
                <option value="">Selecione uma pessoa existente (opcional)</option>
            </select>
            <span asp-validation-for="Input.PessoaId" class="text-danger small"></span>
            <div class="form-text">Se selecionar uma pessoa, os campos de novo cadastro abaixo serão ignorados.</div>
        </div>
    </div>
</div>

<hr class="my-4" />

<div class="mb-4">
    <h3 class="h6 fw-semibold mb-3">02. Nova pessoa</h3>
    <div class="row g-3">
        <div class="col-12">
            <label asp-for="Input.Nome" class="form-label"></label>
            <input asp-for="Input.Nome" class="form-control" placeholder="Nome completo ou razão social" autocomplete="name" />
            <span asp-validation-for="Input.Nome" class="text-danger small"></span>
        </div>
        <div class="col-12 col-md-4">
            <label asp-for="Input.TipoDocumento" class="form-label"></label>
            <select asp-for="Input.TipoDocumento" asp-items="Html.GetEnumSelectList<TipoDocumento>()" class="form-select"></select>
        </div>
        <div class="col-12 col-md-8">
            <label asp-for="Input.DocumentoNumero" class="form-label"></label>
            <input asp-for="Input.DocumentoNumero" class="form-control" placeholder="Somente números" inputmode="numeric" />
            <span asp-validation-for="Input.DocumentoNumero" class="text-danger small"></span>
        </div>
    </div>
</div>

<hr class="my-4" />

<div class="mb-4">
    <h3 class="h6 fw-semibold mb-3">03. Contato (opcional)</h3>
    <div class="row g-3">
        <div class="col-12 col-md-4">
            <label asp-for="Input.TipoContato" class="form-label"></label>
            <select asp-for="Input.TipoContato" asp-items="Html.GetEnumSelectList<TipoContato>()" class="form-select"></select>
        </div>
        <div class="col-12 col-md-8">
            <label asp-for="Input.ContatoValor" class="form-label"></label>
            <input asp-for="Input.ContatoValor" class="form-control" placeholder="(00) 00000-0000 ou email@exemplo.com" />
            <span asp-validation-for="Input.ContatoValor" class="text-danger small"></span>
        </div>
    </div>
</div>

<hr class="my-4" />

<div class="mb-4">
    <h3 class="h6 fw-semibold mb-3">04. Endereço principal (opcional)</h3>
    <div class="row g-3">
        <div class="col-12 col-md-8">
            <label asp-for="Input.Logradouro" class="form-label"></label>
            <input asp-for="Input.Logradouro" class="form-control" />
            <span asp-validation-for="Input.Logradouro" class="text-danger small"></span>
        </div>
        <div class="col-12 col-md-4">
            <label asp-for="Input.Numero" class="form-label"></label>
            <input asp-for="Input.Numero" class="form-control" />
        </div>
        <div class="col-12 col-md-6">
            <label asp-for="Input.Complemento" class="form-label"></label>
            <input asp-for="Input.Complemento" class="form-control" />
        </div>
        <div class="col-12 col-md-6">
            <label asp-for="Input.Bairro" class="form-label"></label>
            <input asp-for="Input.Bairro" class="form-control" />
            <span asp-validation-for="Input.Bairro" class="text-danger small"></span>
        </div>
        <div class="col-12 col-md-6">
            <label asp-for="Input.Cidade" class="form-label"></label>
            <input asp-for="Input.Cidade" class="form-control" />
            <span asp-validation-for="Input.Cidade" class="text-danger small"></span>
        </div>
        <div class="col-6 col-md-2">
            <label asp-for="Input.Uf" class="form-label"></label>
            <input asp-for="Input.Uf" class="form-control text-uppercase" maxlength="2" />
            <span asp-validation-for="Input.Uf" class="text-danger small"></span>
        </div>
        <div class="col-6 col-md-4">
            <label asp-for="Input.Cep" class="form-label"></label>
            <input asp-for="Input.Cep" class="form-control" inputmode="numeric" placeholder="00000-000" />
            <span asp-validation-for="Input.Cep" class="text-danger small"></span>
        </div>
    </div>
</div>

<hr class="my-4" />

<div class="row g-3">
    <div class="col-12 col-md-4">
        <label class="form-label d-block">Situação</label>
        <div class="form-check form-switch">
            <input asp-for="Input.Ativo" class="form-check-input" />
            <label asp-for="Input.Ativo" class="form-check-label">Cliente ativo</label>
        </div>
    </div>
    <div class="col-12">
        <label asp-for="Input.Observacao" class="form-label"></label>
        <textarea asp-for="Input.Observacao" class="form-control" rows="3"></textarea>
        <span asp-validation-for="Input.Observacao" class="text-danger small"></span>
    </div>
</div>
