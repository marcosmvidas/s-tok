@page
@model s_tok.Pages.Fornecedor.RegistroModel

@{
    Layout = "_Registro";
    ViewData["PaginaVoltar"] = "/Fornecedor/Index";
    ViewData["TextoVoltar"] = "Voltar";

    if (Model.DadosComplementares is not null)
    {
        ViewData["ModoComplementar"] = true;
        ViewData["Title"] = "Dados complementares do fornecedor";
        ViewData["Descricao"] = "O cadastro principal foi salvo. Inclua os dados vinculados à pessoa.";
        ViewData["PainelTitulo"] = "Complementação do cadastro";
        ViewData["PainelSubtitulo"] = Model.DadosComplementares.NomePessoa;
    }
    else
    {
        ViewData["Title"] = "Novo fornecedor";
        ViewData["Descricao"] = "Vincule uma pessoa existente ou cadastre uma nova pessoa como fornecedor.";
        ViewData["PainelTitulo"] = "Dados do fornecedor";
        ViewData["PainelSubtitulo"] = "Identificação da pessoa e informações comerciais";
        ViewData["TextoSalvar"] = "Salvar fornecedor";
    }
}

@if (Model.DadosComplementares is not null)
{
    <partial name="_DadosComplementaresPessoa" model="Model.DadosComplementares" />
}
else
{
    <div class="mb-4">
        <h3 class="h6 fw-semibold mb-3">01. Pessoa</h3>
        <div class="row g-3">
            <div class="col-12">
                <label asp-for="Input.PessoaId" class="form-label"></label>
                <select asp-for="Input.PessoaId" asp-items="Model.PessoasDisponiveis" class="form-select">
                    <option value="">Selecione uma pessoa existente (opcional)</option>
                </select>
                <span asp-validation-for="Input.PessoaId" class="text-danger small"></span>
                <div class="form-text">Se selecionar uma pessoa existente, o campo de nova pessoa será ignorado.</div>
            </div>
            <div class="col-12">
                <label asp-for="Input.Nome" class="form-label"></label>
                <input asp-for="Input.Nome" class="form-control" placeholder="Nome completo ou razão social" autocomplete="name" />
                <span asp-validation-for="Input.Nome" class="text-danger small"></span>
            </div>
        </div>
    </div>

    <hr class="my-4" />

    <div class="row g-3">
        <div class="col-12 col-md-4">
            <label class="form-label d-block">Situação</label>
            <div class="form-check form-switch">
                <input asp-for="Input.Ativo" class="form-check-input" />
                <label asp-for="Input.Ativo" class="form-check-label">Fornecedor ativo</label>
            </div>
        </div>
        <div class="col-12">
            <label asp-for="Input.Observacao" class="form-label"></label>
            <textarea asp-for="Input.Observacao" class="form-control" rows="3"></textarea>
            <span asp-validation-for="Input.Observacao" class="text-danger small"></span>
        </div>
    </div>

    <section class="mt-4 pt-3 border-top" aria-labelledby="dadosComplementaresTitulo">
        <div class="mb-3">
            <h3 class="h6 fw-semibold mb-1" id="dadosComplementaresTitulo">Dados complementares</h3>
            <p class="text-muted small mb-0">Salve o cadastro principal para vincular contatos, endereços e documento à pessoa.</p>
        </div>
        <div class="row g-3">
            <div class="col-12 col-md-4">
                <div class="border rounded-3 p-3 h-100">
                    <div class="fw-semibold mb-1">Contato</div>
                    <div class="small text-muted mb-3">Telefone, WhatsApp ou e-mail</div>
                    <button type="button" class="btn btn-outline-primary btn-sm" disabled aria-disabled="true">+ Adicionar contato</button>
                </div>
            </div>
            <div class="col-12 col-md-4">
                <div class="border rounded-3 p-3 h-100">
                    <div class="fw-semibold mb-1">Endereço</div>
                    <div class="small text-muted mb-3">Localização e endereço principal</div>
                    <button type="button" class="btn btn-outline-primary btn-sm" disabled aria-disabled="true">+ Adicionar endereço</button>
                </div>
            </div>
            <div class="col-12 col-md-4">
                <div class="border rounded-3 p-3 h-100">
                    <div class="fw-semibold mb-1">Documento</div>
                    <div class="small text-muted mb-3">CPF, CNPJ ou outro documento</div>
                    <button type="button" class="btn btn-outline-primary btn-sm" disabled aria-disabled="true">+ Adicionar documento</button>
                </div>
            </div>
        </div>
        <div class="form-text mt-2">Após salvar, você será direcionado à etapa de complementação, onde os botões estarão disponíveis.</div>
    </section>

}
